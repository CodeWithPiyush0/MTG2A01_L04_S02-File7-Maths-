   "vo_t1_ask_madhav": "चलिए, पता करते हैं, माधव के पास अब कितने ब्लॉक्स बचे हैं?",
   "vo_t1_b6_madhav": "उनमें से छः ब्लॉक्स माधव ने आन्या को दिए हैं।",
   "vo_t1_learn": "आइए, ब्लॉक्स की सहायता से सीखते हैं कि 25 में से 6 घटाने पर कितने बचते हैं।",
   "vo_t2_both_left": "तो, अब यहाँ 1 दहाई और 9 इकाई बचीं।",
   "vo_t2_built": "यह हमने ब्लॉक्स से संख्या पच्चीस बना ली।",
   "vo_t2_cant": "5 इकाई में से 6 इकाई नहीं घटाई जा सकती, चूँकि संख्या 6 बड़ी है और 5 छोटी।",
   "vo_t2_digits": "25 में 2 दहाई और 5 इकाई हैं।",
   "vo_t2_intro": "सबसे पहले ब्लॉक्स की सहायता से 25 बनाते हैं।",
   "vo_t2_ones5": "अब 5 इकाई के लिए 5 ब्लॉक्स रखते हैं।",
   "vo_t2_ones_left": "इन 15 इकाई में से 6 इकाई घटाने पर बचीं, 9 इकाई।",
   "vo_t2_ones_now": "अब यहाँ 15 इकाई हो गईं।",
   "vo_t2_open": "तो हम 1 दहाई को यहाँ लाएँगे और इसको तोड़ेंगे, अब ये 1 दहाई, 10 इकाई में हो गई।",
   "vo_t2_rm_ones": "अब इसमें से 6 इकाई को हटाते हैं,",
   "vo_t2_story_a": "यहाँ हमने पच्चीस में से छः घटाए हैं, तो बचे 19।",
   "vo_t2_story_b": "अब इस डिब्बे में 19 आएगा।",
